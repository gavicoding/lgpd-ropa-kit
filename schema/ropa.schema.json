{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gavicoding/lgpd-ropa-kit/schema/ropa.schema.json",
  "title": "lgpd-ropa-kit inventory",
  "description": "Record of Processing Activities (LGPD art. 37). One organization file plus one file per processing operation.",
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD."
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "art7": {
      "description": "Legal basis of art. 7.",
      "enum": [
        "consent",
        "legal_obligation",
        "public_policy",
        "research",
        "contract",
        "legal_proceedings",
        "protection_of_life",
        "health_protection",
        "legitimate_interest",
        "credit_protection"
      ]
    },
    "art11": {
      "description": "Legal basis of art. 11, for sensitive data.",
      "enum": [
        "consent",
        "legal_obligation",
        "public_policy",
        "research",
        "legal_proceedings",
        "protection_of_life",
        "health_protection",
        "fraud_prevention"
      ]
    },
    "sensitiveCategory": {
      "description": "Sensitive data category of art. 5, II.",
      "enum": [
        "racial_ethnic_origin",
        "religious_belief",
        "political_opinion",
        "organization_membership",
        "health",
        "sex_life",
        "genetic",
        "biometric"
      ]
    },
    "art33": {
      "description": "International transfer mechanism of art. 33.",
      "enum": [
        "adequacy",
        "specific_clauses",
        "standard_clauses",
        "binding_corporate_rules",
        "certification",
        "international_cooperation",
        "protection_of_life",
        "anpd_authorization",
        "international_commitment",
        "public_policy",
        "specific_consent",
        "legal_basis_art7"
      ]
    },
    "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  },
  "organization": {
    "type": "object",
    "additionalProperties": false,
    "required": ["controller"],
    "properties": {
      "controller": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "$ref": "#/$defs/nonEmptyString" },
          "cnpj": { "type": "string" },
          "address": { "type": "string" }
        }
      },
      "dpo": {
        "description": "Data protection officer (encarregado), art. 41.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "channel": { "type": "string", "description": "Public contact page or form." }
        }
      },
      "reviewed_at": { "$ref": "#/$defs/isoDate" }
    }
  },
  "operation": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "area", "purpose", "legal_basis", "personal_data"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "Stable identifier, lowercase letters, digits and hyphens."
      },
      "name": { "$ref": "#/$defs/nonEmptyString" },
      "area": { "$ref": "#/$defs/nonEmptyString" },
      "owner": { "type": "string", "description": "Team or role accountable for the operation." },
      "purpose": { "$ref": "#/$defs/nonEmptyString" },
      "data_subjects": { "$ref": "#/$defs/stringList" },
      "personal_data": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/nonEmptyString" }
      },
      "sensitive_data": {
        "type": "array",
        "items": { "$ref": "#/$defs/sensitiveCategory" },
        "uniqueItems": true
      },
      "children_data": {
        "type": "boolean",
        "description": "Processes data of children or adolescents (art. 14)."
      },
      "legal_basis": { "$ref": "#/$defs/art7" },
      "sensitive_legal_basis": { "$ref": "#/$defs/art11" },
      "lia": {
        "description": "Legitimate interest assessment (art. 10).",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": { "$ref": "#/$defs/isoDate" },
          "reference": { "type": "string" },
          "outcome": { "enum": ["approved", "approved_with_measures", "rejected"] }
        }
      },
      "retention": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "period": { "type": "string" },
          "justification": { "type": "string" },
          "disposal": { "type": "string", "description": "How the data is deleted or anonymized." }
        }
      },
      "systems": { "$ref": "#/$defs/stringList" },
      "processors": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "$ref": "#/$defs/nonEmptyString" },
            "service": { "type": "string" },
            "country": { "type": "string" },
            "contract": { "type": "boolean" },
            "dpa": { "type": "boolean", "description": "Data processing clauses signed." }
          }
        }
      },
      "sharing": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recipient"],
          "properties": {
            "recipient": { "$ref": "#/$defs/nonEmptyString" },
            "purpose": { "type": "string" }
          }
        }
      },
      "international_transfers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["country"],
          "properties": {
            "country": { "$ref": "#/$defs/nonEmptyString" },
            "recipient": { "type": "string" },
            "mechanism": { "$ref": "#/$defs/art33" }
          }
        }
      },
      "security_measures": { "$ref": "#/$defs/stringList" },
      "risk": {
        "type": "object",
        "additionalProperties": false,
        "required": ["likelihood", "impact"],
        "properties": {
          "likelihood": { "$ref": "#/$defs/score" },
          "impact": { "$ref": "#/$defs/score" },
          "requires_dpia": {
            "type": "boolean",
            "description": "Overrides the automatic decision on whether a DPIA (RIPD) is needed."
          }
        }
      },
      "dpia": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "enum": ["not_started", "in_progress", "done"] },
          "reference": { "type": "string" },
          "date": { "$ref": "#/$defs/isoDate" }
        }
      },
      "notes": { "type": "string" }
    }
  }
}
